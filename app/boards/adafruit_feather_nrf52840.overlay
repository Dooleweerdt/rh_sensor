#include <adafruit_feather_nrf52840_map.dtsi>

/ {
	/* This uses the same gpio as th user button declared in board file! */
	example_sensor: example-sensor {
		compatible = "zephyr,example-sensor";
		input-gpios = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	blink_led: blink-led {
		compatible = "blink-gpio-led";
		led-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		blink-period-ms = <1000>;
	};

	buttons {
		compatible = "gpio-keys";

		buttonA: button_A {
			//gpios = <&feather_header 16 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; feather_header can't be mapped into dt-rust.yml... ToDo...?
			gpios = <&gpio0 26 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch A";
		};

		buttonB: button_B {
			//gpios = <&feather_header 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch B";
		};

		buttonC: button_C {
			//gpios = <&feather_header 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			gpios = <&gpio1 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch C";
		};
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
        zephyr,display = &ssd1306_ssd1306_128x32;
	};
	
	aliases {
		userbutton = &buttonB;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&i2c0 { /* SDA P0.12, SCL P0.11, Alert P1.08 */
	sht3xd:sht3xd@45 {
		compatible = "sensirion,sht3xd";
		reg = <0x45>; /* ADDR pin pulled high, else 0x44 */
		//alert-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>; Disable IRQ pin - only used with polling
	};
};

&feather_i2c {
	status = "okay";

	ssd1306_ssd1306_128x32: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		segment-remap;
		com-invdir;
		com-sequential;
		prechargep = <0x22>;
	};
};

&feather_serial {
	status = "okay";

	w1_0: w1-zephyr-serial-0 {
		compatible = "zephyr,w1-serial";
		status = "okay";

		ds18b20 {
			compatible = "maxim,ds18b20";
			family-code = <0x28>;
			resolution = <12>;
			status = "okay";
		};
	};
};
