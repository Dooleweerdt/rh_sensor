/* This devicetree overlay file will be automatically picked by the Zephyr
 * build system when building the sample for the esp32c3_devkitm board. It shows
 * how the example-application can be built on sample boards already provided
 * by Zephyr.
 */

/ {
	aliases {
		led0 = &blue_led;
		//userbutton = &user_button1;
	};

	example_sensor: example-sensor {
		compatible = "zephyr,example-sensor";
		input-gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

    /* Define the 1-Wire bus at the root level */
    w1: w1 {
        compatible = "zephyr,w1-gpio";
        /* Pick an available GPIO, e.g., GPIO 4 */
        gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        status = "okay";

        ds18b20: ds18b20 {
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;
            status = "okay";
        };
    };

	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
 		zephyr,uart-mcumgr = &usb_serial; 
 	};
};

&i2c0 { /* SDA P8, SCL P9, Alert P1 */
	status = "okay";
	sht3xd:sht3xd@45 {
		compatible = "sensirion,sht3xd";
		reg = <0x45>; /* ADDR pin pulled high, else 0x44 */
		//alert-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>; - Only used in polling, so remove IRQ pin.
	};
};

&usb_serial {
	status = "okay";
};

&wifi {
    status = "okay";
};
